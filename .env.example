# CropCraft settings. Copy to .env to override; every value has a working
# default derived from the repository root, so .env is optional.
#
# All settings are read by src/cropcraft/config.py via pydantic-settings.

# Enable FastAPI debug mode. Leave false outside local development.
CROPCRAFT_DEBUG=false

# Model artifacts, built by the scripts in ml/.
# CROPCRAFT_CROP_MODEL_PATH=models/crop_recommender.joblib
# CROPCRAFT_PEST_MODEL_PATH=models/pest_classifier.keras
# CROPCRAFT_PEST_LABELS_PATH=models/pest_labels.json

# Per-crop NPK requirements.
# CROPCRAFT_CROP_NPK_PATH=Data/Crop_NPK.csv

# Largest pest photo accepted, in bytes (default 8 MiB).
# CROPCRAFT_MAX_UPLOAD_BYTES=8388608

# Upload MIME types accepted, as a JSON array. The declared type is only a cheap
# first filter; the real check is whether Pillow can decode the bytes.
# CROPCRAFT_ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

# Square size the pest classifier expects. Must match the trained model.
# CROPCRAFT_PEST_IMAGE_SIZE=224
